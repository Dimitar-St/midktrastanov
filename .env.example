# Public build-time URL. Use same-origin Worker gateway in production.
VITE_API_BASE_URL=/api
# Browser-restricted Google Maps JavaScript API key for the address overview.
VITE_GOOGLE_MAPS_API_KEY=
# Local Vite proxy routes API requests directly to the Go backend.
DEV_API_PROXY_TARGET=http://localhost:8080
# Docker Compose database settings. These are not exposed to the browser.
POSTGRES_DB=buldez
POSTGRES_USER=buldez
POSTGRES_PASSWORD=change-me
# Shared Worker-to-API credential and user-session signing secret.
BACKEND_API_TOKEN=local-development-token
SESSION_SECRET=replace-with-a-long-random-secret
SEED_COMPANY_NAME=БулДез Контрол
SEED_ADMIN_NAME=Администратор
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-this-password
