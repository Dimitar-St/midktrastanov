PORT=8080
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:8787
# PostgreSQL connection string. sslmode=disable is only suitable for local development.
DATABASE_URL=postgres://buldez:change-me@localhost:5432/buldez?sslmode=disable
# Shared only between the Worker and this API. Do not expose it to the browser.
BACKEND_API_TOKEN=local-development-token
# A long random value used to sign 12-hour user sessions.
SESSION_SECRET=replace-with-a-long-random-secret
# Optional first company administrator, created only when the username does not exist.
SEED_COMPANY_NAME=БулДез Контрол
SEED_ADMIN_NAME=Администратор
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-this-password
